# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | test | production

DATABASE_URL=postgresql+psycopg://priorart:priorart@localhost:54329/priorart

# Secrets (required, no defaults). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Rotation: set a new FERNET_KEY and list the previous key(s) here, comma separated.
FERNET_OLD_KEYS=

# Web
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=true             # must be true in production
TRUST_PROXY_HEADERS=false      # true only behind a reverse proxy you control (Caddy)

# Rate limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_LLM=6/minute

# Optional search tuning
# HNSW_EF_SEARCH=80
# RERANK_DEPTH=40
# RESULT_LIMIT=10
