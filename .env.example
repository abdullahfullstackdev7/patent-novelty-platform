# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | test | production

DATABASE_URL=postgresql+psycopg://priorart:priorart@localhost:54329/priorart

# Secrets (required, no defaults). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Rotation: set a new FERNET_KEY and list the previous key(s) here, comma separated.
FERNET_OLD_KEYS=

# Web
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=true             # must be true in production
TRUST_PROXY_HEADERS=false      # true only behind a reverse proxy you control (Caddy)

# Rate limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_LLM=6/minute

# Optional search tuning
# HNSW_EF_SEARCH=80
# RERANK_DEPTH=40
# RESULT_LIMIT=10

# LLM gateway (all optional: a provider without a key is simply unavailable)
LLM_MODE=auto                  # auto | groq | gemini | local_only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # never a Gemini 2.5 model (shutdown 16 Oct 2026)
# Free-tier limits the gateway plans around. Check aistudio.google.com/rate-limit for Gemini.
# GROQ_TPM=8000
# GROQ_TPD=200000
# GEMINI_RPM=10
# GEMINI_RPD=250

# Analysis pipeline (optional, these are the defaults). Run the worker with: python -m app.worker
# PIPELINE_REFERENCES=3
# PIPELINE_LOW_THRESHOLD=0.35
# PIPELINE_HIGH_THRESHOLD=0.88
# JOB_MAX_ATTEMPTS=3
# JOB_STUCK_MINUTES=15
